{
  "name": "invoice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "validate-translations": "node scripts/validate-translations.js",
    "prebuild": "npm run validate-translations",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:i18n": "tsx scripts/run-i18n-tests.ts",
    "test:i18n:watch": "tsx scripts/run-i18n-tests.ts --watch",
    "test:i18n:coverage": "tsx scripts/run-i18n-tests.ts --coverage",
    "test:i18n:ui": "tsx scripts/run-i18n-tests.ts --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:setup": "playwright test --project=setup",
    "test:e2e:fast": "playwright test --project=no-setup",
    "test:e2e:fast:ui": "playwright test --project=no-setup --ui",
    "test:e2e:fast:debug": "DEBUG=1 playwright test --project=no-setup --debug",
    "test:e2e:a11y": "RUN_A11Y_TESTS=true playwright test --grep @a11y",
    "test:e2e:functional": "RUN_A11Y_TESTS=false playwright test --grep-invert @a11y",
    "test:e2e:all-with-a11y": "RUN_A11Y_TESTS=true playwright test",
    "test:e2e:all-no-a11y": "RUN_A11Y_TESTS=false playwright test",
    "test:header": "playwright test tests/header-*.spec.ts",
    "test:header:accessibility": "RUN_A11Y_TESTS=true playwright test tests/header-accessibility.spec.ts",
    "test:header:visual": "playwright test tests/header-visual-regression.spec.ts",
    "test:header:functionality": "playwright test tests/header-functionality.spec.ts",
    "email:start": "docker-compose -f docker-compose.test.yml up -d inbucket",
    "email:stop": "docker-compose -f docker-compose.test.yml down",
    "email:logs": "docker-compose -f docker-compose.test.yml logs -f inbucket",
    "email:ui": "open http://localhost:9000",
    "test:email": "USE_EMAIL_TESTING=true playwright test --grep @email",
    "test:email:setup": "npm run email:start && sleep 5",
    "test:email:teardown": "npm run email:stop",
    "test:email:full": "npm run test:email:setup && npm run test:email; npm run test:email:teardown",
    "test:with-email": "USE_EMAIL_TESTING=true npm run test:e2e",
    "test:no-email": "USE_EMAIL_TESTING=false npm run test:e2e",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:studio": "open http://127.0.0.1:54323",
    "test:local": "npm run supabase:start && npm run test:e2e",
    "test:setup": "npm run supabase:start",
    "test:teardown": "npm run supabase:stop",
    "test:debug": "DEBUG=1 npm run test:e2e",
    "test:headed": "DEBUG=1 npm run test:e2e -- --headed",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "test:clean": "rm -rf test-results/ playwright-report/ && find tests/ -name '*.png' -delete",
    "notifications:test": "tsx scripts/test-notifications.ts",
    "notifications:generate": "tsx scripts/generate-notifications.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@react-pdf/renderer": "^3.4.2",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "canvg": "^4.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "0.2.1",
    "country-flag-icons": "^1.5.11",
    "date-fns": "^3.6.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.0.23",
    "geist": "^1.3.0",
    "lucide-react": "^0.364.0",
    "next": "latest",
    "next-intl": "^4.1.0",
    "react": "latest",
    "react-day-picker": "^8.10.0",
    "react-dom": "latest",
    "react-hook-form": "^7.51.3",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/forms": "^0.5.7",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.3.1",
    "@vitest/ui": "^1.3.1",
    "autoprefixer": "^10.0.1",
    "dotenv": "^16.5.0",
    "eslint": "^8",
    "eslint-config-next": "latest",
    "jsdom": "^24.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vitest": "^1.3.1"
  }
}
